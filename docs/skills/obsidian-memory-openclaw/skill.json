{
  "name": "obsidian-memory-openclaw",
  "version": "0.1.0",
  "description": "Full Obsidian-Memory integration for OpenClaw agents — knowledge management, graph traversal, session tracking, and agent memory workflows",
  "author": "jodfie",
  "license": "MIT",
  "homepage": "https://github.com/jodfie/Obsidian-Memory",
  "keywords": ["memory", "knowledge", "obsidian", "notes", "agent", "openclaw", "graph"],
  "sbom": {
