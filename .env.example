# Obsidian-Memory Environment Configuration Template
# Copy this file to .env.dev or .env.prod and fill in actual values

# ============================================================================
# Memory Configuration
# ============================================================================
BASIC_MEMORY_HOME=/data
BASIC_MEMORY_SYNC_CHANGES=true
BASIC_MEMORY_SYNC_DELAY=1000

# ============================================================================
# Application Configuration
# ============================================================================
LOG_LEVEL=INFO
DEBUG=false
API_TITLE=Obsidian-Memory
API_VERSION=0.1.0

# ============================================================================
# Vault Configuration
# ============================================================================
# Path to Obsidian vault (optional, can be configured via API)
VAULT_PATH=

# ============================================================================
# Git Auto-Commit Configuration
# ============================================================================
GIT_AUTO_COMMIT=false
GIT_REMOTE=origin

# ============================================================================
# Authentication
# ============================================================================
# Set to true to require Bearer token authentication
REQUIRE_AUTH=false
# Bearer token for API authentication (if REQUIRE_AUTH=true)
API_TOKEN=

# ============================================================================
# Cloudflare Access
# ============================================================================
# Enable Cloudflare Access authentication
CLOUDFLARE_ACCESS_ENABLED=false
# Cloudflare Access team domain (e.g., example.cloudflareaccess.com)
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# ============================================================================
# AI Processing
# ============================================================================
# Anthropic Claude API key for AI features
ANTHROPIC_API_KEY=

# ============================================================================
# Device Identification
# ============================================================================
# Device ID for cross-device sync tracking (auto-generated if not set)
DEVICE_ID=

# ============================================================================
# Supabase Configuration
# ============================================================================
# Supabase project URL (from Supabase dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (NEVER expose in browser - backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection string (for direct Postgres access)
# Format: postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
DATABASE_URL=

# Database mode: "sqlite" (legacy) or "postgres" (new)
DB_MODE=sqlite

# ============================================================================
# ElectricSQL Sync
# ============================================================================
# URL to your ElectricSQL sync service
# For Fly.io deployment: https://obsidian-memory-electric.fly.dev
# For local development: http://localhost:3000
ELECTRIC_URL=

# Enable Electric sync (set to true when Electric is deployed)
ELECTRIC_ENABLED=false

# ============================================================================
# OAuth Configuration (for Supabase Auth)
# ============================================================================
# GitHub OAuth (register at: https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional - register at: https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
