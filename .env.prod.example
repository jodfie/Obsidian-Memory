# Production Environment Configuration
# Copy this to .env.prod and customize with actual secrets

# Memory Configuration
BASIC_MEMORY_HOME=/data
BASIC_MEMORY_SYNC_CHANGES=true
BASIC_MEMORY_SYNC_DELAY=1000

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
API_TITLE=Obsidian-Memory
API_VERSION=0.1.0

# Vault Configuration
VAULT_PATH=/vaults/prod-vault

# Git Configuration
GIT_AUTO_COMMIT=true
GIT_REMOTE=origin

# Authentication (REQUIRED in production)
REQUIRE_AUTH=true
API_TOKEN=CHANGE_ME_STRONG_RANDOM_TOKEN

# Cloudflare Access (optional)
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# AI Processing
ANTHROPIC_API_KEY=CHANGE_ME

# Device ID
DEVICE_ID=prod-server
