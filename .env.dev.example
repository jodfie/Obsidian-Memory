# Development Environment Configuration
# Copy this to .env.dev and customize

# Memory Configuration
BASIC_MEMORY_HOME=/data
BASIC_MEMORY_SYNC_CHANGES=true
BASIC_MEMORY_SYNC_DELAY=1000

# Application Configuration
LOG_LEVEL=DEBUG
DEBUG=true
API_TITLE=Obsidian-Memory (Dev)
API_VERSION=0.1.0-dev

# Vault Configuration
VAULT_PATH=/vaults/dev-vault

# Git Configuration
GIT_AUTO_COMMIT=true
GIT_REMOTE=origin

# Authentication (disabled in dev)
REQUIRE_AUTH=false
API_TOKEN=

# Cloudflare Access (disabled in dev)
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# AI Processing
ANTHROPIC_API_KEY=

# Device ID
DEVICE_ID=dev-server
