# ElectricSQL Environment Configuration
# Copy this file to .env and fill in actual values

# ============================================================================
# Database Connection
# ============================================================================
# Supabase Postgres connection string
# IMPORTANT: Use the IPv6 connection string for Supabase free tier
#
# Format: postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres
#
# To get your connection string:
# 1. Go to Supabase Dashboard > Project Settings > Database
# 2. Under "Connection string", select "URI"
# 3. Copy the "Connection string" (NOT the pooler connection string)
# 4. For IPv6: Use the direct host ending in .supabase.co
#
# Example (IPv6):
# DATABASE_URL=postgresql://postgres.abcdefghijkl:your-password@db.abcdefghijkl.supabase.co:5432/postgres
#
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ============================================================================
# Electric Configuration
# ============================================================================
# Write mode for syncing changes back to Postgres
# "direct" - Electric writes directly to Postgres (recommended)
# "logical_replication" - Uses logical replication
ELECTRIC_WRITE_TO_PG_MODE=direct

# Port for the PG proxy (used by Electric clients)
PG_PROXY_PORT=65432

# ============================================================================
# Optional Configuration
# ============================================================================
# Log level: debug, info, warning, error
# LOG_LEVEL=info

# Enable detailed Electric debug logging
# ELECTRIC_DEBUG=false
